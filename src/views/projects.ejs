<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
    <ul>
        <% projects.forEach(project => { %>
            <li>
                <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
                <p>Organization: <a href="/organizations/<%= project.organization_id %>"><%= project.organization_name %></a></p>
                <p><strong>Date:</strong> <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                <p><strong>Description:</strong> <%= project.description %></p>
                <p><strong>Location:</strong> <%= project.location %></p>
            </li>
        <% }); %>
    </ul>
</main>
<p><a href="/new-project">Add a New Service Project</a></p>
<%- include('partials/footer') %>
